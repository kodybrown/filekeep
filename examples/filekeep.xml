<?xml version="1.0" encoding="utf-8"?>
<settings>
  <entries>
    <id>hosts</id>
    <source><type>hosts_file</type></source>
    <destination>${HOME}/Documents/Settings/(files)/HOSTS file</destination>
    <filename>${HOST}-HOSTS-${date:yyyyMMdd}.txt</filename>
    <skip_if_unchanged>true</skip_if_unchanged>
  </entries>
  <entries>
    <id>environment</id>
    <source>
      <type>environment</type>
      <scopes>machine</scopes>
      <scopes>user</scopes>
    </source>
    <destination>${HOME}/Documents/Settings/(files)/Environment Variables</destination>
    <filename>${HOST}-ENVARS-${date:yyyyMMdd}.txt</filename>
    <skip_if_unchanged>true</skip_if_unchanged>
  </entries>
</settings>
